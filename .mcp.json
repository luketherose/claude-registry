{
  "mcpServers": {
    "uml": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/antoinebou12/uml-mcp@78137bd66bfeb9754d0d5de0be1016f4dc053cc6",
        "uml-mcp"
      ],
      "env": {
        "PLANTUML_SERVER": "https://www.plantuml.com/plantuml",
        "UML_OUTPUT_DIR": "docs/diagrams"
      }
    },
    "browser": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@0.0.79"
      ]
    }
  }
}
