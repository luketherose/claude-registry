{
  "_comment": "Workflow registry — machine-readable index of all available use-case workflows. Each entry is a self-contained module with its own supervisor, phases, shared agents, and trigger phrases. Adding a new use case = adding an entry here + the corresponding agent cluster in claude-catalog/.",
  "version": "1.0.0",
  "workflows": [
    {
      "id": "application-replatforming",
      "name": "Application Replatforming",
      "description": "End-to-end AS-IS→TO-BE migration of any legacy codebase. Covers indexing, functional analysis, technical analysis, baseline testing, and incremental replatforming with continuous validation.",
      "entry_agent": "refactoring-supervisor",
      "status": "stable",
      "trigger_phrases": [
        "Start the application replatforming workflow",
        "Lancia il refactoring",
        "Run Phase",
        "Resume Phase",
        "Index this codebase",
        "Produce the functional analysis",
        "Run the baseline tests"
      ],
      "phases": [
        {
          "id": "phase-0",
          "name": "Codebase Indexing",
          "supervisor": "indexing-supervisor",
          "output_dir": ".indexing-kb/",
          "state_file": ".indexing-kb/_meta/pipeline-state.yaml",
          "can_run_standalone": true
        },
        {
          "id": "phase-1",
          "name": "Functional Analysis",
          "supervisor": "functional-analysis-supervisor",
          "output_dir": "docs/analysis/01-functional/",
          "state_file": "docs/analysis/01-functional/_meta/pipeline-state.yaml",
          "requires": ["phase-0"],
          "can_run_standalone": true
        },
        {
          "id": "phase-2",
          "name": "Technical Analysis",
          "supervisor": "technical-analysis-supervisor",
          "output_dir": "docs/analysis/02-technical/",
          "state_file": "docs/analysis/02-technical/_meta/pipeline-state.yaml",
          "requires": ["phase-0"],
          "can_run_standalone": true
        },
        {
          "id": "phase-3",
          "name": "Baseline Testing",
          "supervisor": "baseline-testing-supervisor",
          "output_dir": "tests/baseline/",
          "state_file": "tests/baseline/_meta/pipeline-state.yaml",
          "requires": ["phase-0", "phase-1"],
          "can_run_standalone": true
        },
        {
          "id": "phase-4",
          "name": "Application Replatforming",
          "supervisor": "refactoring-supervisor",
          "output_dirs": ["backend/", "frontend/", "docs/refactoring/", "e2e/"],
          "state_file": ".refactoring-kb/pipeline-state.yaml",
          "requires": ["phase-0", "phase-1", "phase-2", "phase-3"],
          "can_run_standalone": false,
          "steps": [
            {"id": "step-0", "name": "Bootstrap hard gate"},
            {"id": "step-1", "name": "Minimal runnable skeleton"},
            {"id": "step-2", "name": "Incremental feature loop"},
            {"id": "step-3", "name": "Mandatory validation loop"},
            {"id": "step-4", "name": "Progressive system construction"},
            {"id": "step-5", "name": "Hardening"},
            {"id": "step-5.5", "name": "Test data seeding"},
            {"id": "step-6", "name": "Final validation"}
          ]
        },
        {
          "id": "retrospective",
          "name": "Workflow Retrospective",
          "type": "quality-gate",
          "supervisor": "refactoring-supervisor",
          "output_dir": "docs/refactoring/",
          "output_file": "docs/refactoring/retrospective.md",
          "state_file": "docs/refactoring/workflow-manifest.json",
          "triggers": ["after-phase-4-sign-off", "explicit-user-request"],
          "requires": ["phase-4"],
          "can_run_standalone": false,
          "can_trigger_cross_phase_iteration": true,
          "cross_phase_iteration_reentry": "phase-1"
        }
      ],
      "shared_agents": [
        "developer-java",
        "developer-java-spring",
        "developer-frontend",
        "developer-python",
        "test-writer",
        "debugger",
        "code-reviewer",
        "software-architect",
        "api-designer",
        "document-creator",
        "presentation-creator",
        "deliberative-decision-engine"
      ],
      "cross_cutting": {
        "deliberation": {
          "agent": "deliberative-decision-engine",
          "trigger": "decisionMode: deliberative OR explicit user request",
          "produces": ".deliberation-kb/<trace-id>/"
        }
      }
    }
  ],
  "how_to_add_new_use_case": "See claude-catalog/templates/new-use-case/README.md for the 7-step guide."
}
